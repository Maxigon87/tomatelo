<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo Gradiente Principal -->
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:endColor="#2F80ED"
                android:startColor="#56CCF2" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Grupo de Burbujas 1 (Arriba Izquierda) -->
    <item android:top="20dp" android:left="25dp" android:gravity="top|start">
        <shape android:shape="oval">
            <solid android:color="#20FFFFFF" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
            <size android:width="28dp" android:height="28dp"/>
        </shape>
    </item>
    <item android:top="38dp" android:left="10dp" android:gravity="top|start">
        <shape android:shape="oval">
            <solid android:color="#10FFFFFF" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
            <size android:width="18dp" android:height="18dp"/>
        </shape>
    </item>
    <item android:top="15dp" android:left="50dp" android:gravity="top|start">
        <shape android:shape="oval">
            <solid android:color="#15FFFFFF" />
            <stroke android:width="1dp" android:color="#35FFFFFF" />
            <size android:width="14dp" android:height="14dp"/>
        </shape>
    </item>

    <!-- Grupo de Burbujas 2 (Arriba Derecha) -->
    <item android:top="15dp" android:right="30dp" android:gravity="top|end">
        <shape android:shape="oval">
            <solid android:color="#20FFFFFF" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
            <size android:width="35dp" android:height="35dp"/>
        </shape>
    </item>
    <item android:top="40dp" android:right="15dp" android:gravity="top|end">
        <shape android:shape="oval">
            <solid android:color="#15FFFFFF" />
            <stroke android:width="1dp" android:color="#35FFFFFF" />
            <size android:width="20dp" android:height="20dp"/>
        </shape>
    </item>
    
    <!-- Grupo de Burbujas 3 (Abajo Centro) -->
    <item android:bottom="35dp" android:left="110dp" android:gravity="bottom|start">
        <shape android:shape="oval">
            <solid android:color="#10FFFFFF" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
            <size android:width="24dp" android:height="24dp"/>
        </shape>
    </item>
    <item android:bottom="15dp" android:left="130dp" android:gravity="bottom|start">
        <shape android:shape="oval">
            <solid android:color="#20FFFFFF" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
            <size android:width="32dp" android:height="32dp"/>
        </shape>
    </item>

</layer-list>
